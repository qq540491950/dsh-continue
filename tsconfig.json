{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "legacy",
    "strict": true,
    "alwaysStrict": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": [],
    "declaration": false,
    "sourceMap": false,
    "removeComments": false,
    "newLine": "lf",
    "rootDir": "src",
    "outDir": ".build"
  },
  "include": ["src/**/*.ts"]
}
