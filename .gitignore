# 依赖
node_modules/
.pnpm-store/

# 构建产物 / 缓存
dist/
build/
out/
# tsc 的中间产物（lib/ 是提交进仓库的投递产物，.build/ 只是它的一次性暂存）
.build/
*.tsbuildinfo
.cache/

# 日志
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# 环境变量与本地私有配置（.env.example 等模板要保留）
.env
.env.*
!.env.example

# 编辑器 / IDE
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# 操作系统
.DS_Store
Thumbs.db
desktop.ini
